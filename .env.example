# ========================================================
# MaNa Angadi & Hindsight Agent Memory Environment Config
# ========================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Secret for Multi-Role Authentication
JWT_SECRET=mana_angadi_super_secret_jwt_key_2026_production

# ========================================================
# Hindsight Persistent Agent Memory Configuration
# Official Documentation: https://hindsight.vectorize.io/
# ========================================================
# Remote Vectorize Hindsight API URL (defaults to resilient local fallback if unreachable)
HINDSIGHT_API_URL=http://localhost:8000
HINDSIGHT_API_KEY=your_hindsight_api_key_here
HINDSIGHT_TIMEOUT_MS=4000

# ========================================================
# LLM Provider Configuration (Optional / Extensible)
# ========================================================
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Database (SQLite default in data/mana_angadi.db)
DB_PATH=./data/mana_angadi.db
